PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ghostnet
CLIENT_URL=http://localhost:5173

# AI Provider Configuration (Options: 'ollama', 'openai_compatible', 'mock')
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2
AI_API_KEY=

# Search Provider Configuration (Options: 'duckduckgo', 'wikipedia', 'tavily', 'mock')
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Execution Limits
MAX_AGENT_CALLS=12
AGENT_TIMEOUT_MS=60000
MAX_SEARCH_RESULTS=6
