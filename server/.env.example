PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ghostnet
CLIENT_URL=http://localhost:5173

# Multi-Agent Courtroom AI Configuration (Groq + Sarvam + Gemma 4 via Gemini API)
AI_PROVIDER=multi_courtroom

# Groq (Ghost Agent & Defense Agent)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Sarvam AI (Prosecutor Agent & Fact-Checker)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL=sarvam-105b

# Gemini API / Gemma 4 (Supreme Judge Agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Search Provider Configuration (Options: 'duckduckgo', 'wikipedia', 'tavily', 'mock')
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Execution Limits
MAX_AGENT_CALLS=12
AGENT_TIMEOUT_MS=60000
MAX_SEARCH_RESULTS=6
